  "primary_entity": "VR-ASI-CO",
  "learning_architecture": {
    "primary_repository": "dpstudio-se/VR-ASI-CO",
    "primary_entity": "VR-ASI-CO",
    "gen2": {
      "location": "inside_primary_repository",
      "status": "integrated_learning_system",
      "components": {
        "upi_fysik": {
          "role": "adaptive practical physics knowledge system",
          "learns_from": [
            "verified_practical_experience",
            "observations",
            "calculations",
            "experiments",
            "sources",
            "AI_task_results",
            "reviewed_persona_patterns"
          ],
          "rigor": "evidence_and_provenance_required; less restrictive than Gen1; never silently promotes hypotheses",
          "fallback": "UPI Gen1 separate repository",
          "canonical_path": "upi/gen2/physics/"
        },
        "upi_persona": {
          "role": "experience, persona and pattern learning subsystem",
          "learns_from": [
            "explicit_user_feedback",
            "AI_workflows",
            "task_outcomes",
            "repeated_patterns",
            "practical_methods",
            "contextual_observations"
          ],
          "models": [
            "persona_preferences",
            "behavioral_patterns",
            "project_constants",
            "flows",
            "candidate_connections"
          ],
          "outputs": "contextual patterns and candidate knowledge for UPI Fysik",
          "safeguards": [
            "attributable_observations",
            "uncertainty",
            "counterexamples",
            "user_correction",
            "privacy_and_consent"
          ],
          "canonical_path": "upi/gen2/persona/"
        }
      },
      "cross_learning": "UPI Persona surfaces practical patterns and experience; UPI Fysik formalizes, models, tests and returns constrained knowledge. Both subsystems may learn from each other's reviewed records.",
      "visibility": "internal_hidden_layer_by_default",
      "learning": "automatic_observation_capture_and_candidate_generation_when_runtime_supports_it",
      "publication": "reviewed_and_versioned; no unverified promotion to EST",
      "cross_link_path": "upi/gen2/links/",
      "learning_lifecycle_path": "upi/gen2/learning/",
      "runtime_contract": "upi/gen2/learning/GEN2_RUNTIME_CONTRACT.md",
      "event_schema": "upi/gen2/learning/schemas/event.schema.json",
      "health_schema": "upi/gen2/learning/schemas/health.schema.json",
      "runtime_status": "CONTRACT_DEFINED_RUNTIME_NOT_YET_IMPLEMENTED_OR_VERIFIED",
      "implementation_boundary": {
        "persona_learning_engine": "src/lib/upi/persona-learning.mjs (bounded RNA proposals only)",
        "local_replay": "scripts/upi-persona-learning.mjs (no durable write, no remote read-back, no inference)",
        "canonical_event_ledger": "NOT_IMPLEMENTED",
        "durable_cross_learning_worker": "NOT_IMPLEMENTED",
        "gen1_automatic_failover": "NOT_IMPLEMENTED",
        "runtime_health_endpoint": "NOT_IMPLEMENTED",
        "validation_commands": [
          "npm run upi:gen2:validate",
          "npm run test:upi:gen2"
        ]
      }
    },
    "gen1": {
      "repository": "dpstudio-se/Universal-Physics-Index-UPI",
      "role": "separate strict physics fallback and reference",
      "priority": "secondary_fallback",
      "use_when": [
        "Gen2_unavailable",
        "Gen2_corrupted",
        "Gen2_inconsistent",
        "strict_physics_cross_check"
      ],
      "access": "read_only_by_default",
      "mutation_from_gen2": false,
      "revision_pin_required": true
    }
  },
