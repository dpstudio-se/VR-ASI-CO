{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpstudio-se/VR-ASI-CO/blob/main/upi/gen2/physics/schemas/claim.schema.json",
  "title": "VR-ASI-CO Scientific Claim",
  "type": "object",
  "required": ["id", "statement", "status", "domain", "scope", "sources", "limitations"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{4,100}$"},
    "statement": {"type":"string","minLength":8},
    "status": {"enum":["EST","DER","HYP","SYM","SEM-LOSS","STOP","ERR"]},
    "domain": {"type":"string","minLength":2},
    "scope": {"type":"string","minLength":5},
    "variables": {"type":"array","items":{"type":"object","required":["symbol","meaning","unit","dimension"],"properties":{"symbol":{"type":"string"},"meaning":{"type":"string"},"unit":{"type":"string"},"dimension":{"type":"string"}},"additionalProperties":false}},
    "assumptions": {"type":"array","items":{"type":"string"}},
    "derivation": {"type":"array","items":{"type":"string"}},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","required":["type"],"properties":{"type":{"type":"string"},"title":{"type":"string"},"author":{"type":"string"},"institution":{"type":"string"},"doi":{"type":"string"},"url":{"type":"string","format":"uri"},"path":{"type":"string"},"revision":{"type":"string"},"retrieved":{"type":"string","format":"date"},"related_claims":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},
    "uncertainty": {"type":"string"},
    "protocol": {"type":"string"},
    "required_evidence": {"type":"array","items":{"type":"string"}},
    "falsification": {"type":"string"},
    "limitations": {"type":"array","items":{"type":"string"}},
    "counterexamples": {"type":"array","items":{"type":"string"}},
    "review": {"type":"object","properties":{"reviewer":{"type":"string"},"date":{"type":"string","format":"date"},"decision":{"enum":["PASS","REVISE","QUARANTINE","STOP"]},"notes":{"type":"string"}},"additionalProperties":false}
  },
  "additionalProperties": false,
  "allOf": [
    {"if":{"properties":{"status":{"const":"HYP"}},"required":["status"]},"then":{"required":["required_evidence","falsification"]}},
    {"if":{"properties":{"status":{"const":"DER"}},"required":["status"]},"then":{"required":["derivation","assumptions"]}}
  ]
}