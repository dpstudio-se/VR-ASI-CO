{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpstudio-se/VR-ASI-CO/blob/main/upi/gen2/learning/schemas/event.schema.json",
  "title": "UPI Gen2 Learning Event",
  "type": "object",
  "required": ["event_id","schema_version","event_type","source","observed_at","scope","payload_digest","provenance","authorization"],
  "properties": {
    "event_id": {"type":"string","pattern":"^EVT-[A-Z0-9._-]{6,120}$"},
    "schema_version": {"const":"upi-gen2-event/1.0"},
    "event_type": {"enum":["user_feedback","ai_task_result","workflow_observation","physics_source","measurement","derivation","counterexample","review_decision","system_health"]},
    "source": {"type":"object","required":["kind","id"],"properties":{"kind":{"enum":["user","assistant","tool","document","instrument","runtime","reviewer"]},"id":{"type":"string","minLength":1},"revision":{"type":"string"}}, "additionalProperties":false},
    "observed_at": {"type":"string","format":"date-time"},
    "scope": {"type":"string","minLength":1},
    "payload_digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "payload_ref": {"type":"string","minLength":1},
    "provenance": {"type":"array","minItems":1,"items":{"type":"object","required":["ref","role"],"properties":{"ref":{"type":"string","minLength":1},"role":{"enum":["primary_source","observation","derived_from","tool_output","review_evidence"]},"revision":{"type":"string"}},"additionalProperties":false}},
    "authorization": {"type":"object","required":["principal","purpose","allowed"],"properties":{"principal":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"allowed":{"const":true},"consent_ref":{"type":"string"}},"additionalProperties":false},
    "idempotency_key": {"type":"string","minLength":8,"maxLength":160},
    "related_persona_records": {"type":"array","items":{"type":"string"}},
    "related_physics_claims": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
